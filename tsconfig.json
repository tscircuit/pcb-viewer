{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "services/return-current/worker/**/*.ts"
  ],
  "exclude": [
    "services/return-current/worker/**/*.test.ts",
    "node_modules",
    "services/return-current/container"
  ]
}
