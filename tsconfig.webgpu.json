{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["@webgpu/types"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "node_modules/@tscircuit/circuit-json-webgpu/lib",
    "outDir": "node_modules/@tscircuit/circuit-json-webgpu/dist"
  },
  "include": ["node_modules/@tscircuit/circuit-json-webgpu/lib/**/*.ts"]
}
