{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "../../../scripts/return-current/native-runner.ts",
    "../../../scripts/return-current/protocol.ts"
  ],
  "exclude": ["node_modules"]
}
